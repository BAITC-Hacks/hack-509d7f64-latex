# Copied to .env, this file is read by `docker compose` (all services) and by scripts/speech_services.sh.
# Compose passes only the router variables below. Running the router directly (cd backend && go run ./cmd/router)
# reads backend/.env instead; backend/.env.example lists all router settings.

# --- Go router (layer 2), required
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional bearer token for the router API; the chat gateway sends it automatically (ROUTER_TOKEN).
API_TOKEN=

# --- Speech services / chat, optional
# HF_TOKEN=hf_...                       # if anonymous Hugging Face downloads are blocked from your network
# TORCH_INDEX=https://download.pytorch.org/whl/cu128   # CUDA wheels for the stt/tts images (with docker-compose.gpu.yml)
# ROUTER_URL=http://host.docker.internal:8080/v1/turns  # chat -> a router running outside Docker
# ROUTER_MODE=auto                      # auto | remote | mock
# ROUTER_PORT=8080                      # host port for the router container (change if 8080 is taken)
