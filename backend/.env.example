OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Small model for the fast route; also the L1 fallback unless OPENAI_FALLBACK_MODEL is set.
OPENAI_FAST_MODEL=gpt-4.1-nano
OPENAI_FALLBACK_MODEL=
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/voice_router?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
# Optional bearer token for layer-1/user clients. Empty permits local unauthenticated use.
API_TOKEN=https://platform.openai.com/p/WPGZPTCE7GT4Q227
# Required for review_mode=operator. Must differ from API_TOKEN.
OPERATOR_API_TOKEN=
# Optional dedicated test database for PostgreSQL integration tests.
TEST_DATABASE_URL=
