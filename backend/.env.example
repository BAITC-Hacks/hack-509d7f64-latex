OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Small model for the fast route; also the L1 fallback unless OPENAI_FALLBACK_MODEL is set.
OPENAI_FAST_MODEL=gpt-4.1-nano
OPENAI_FALLBACK_MODEL=
# SQLite file, created and migrated at startup (relative to the working directory).
DB_PATH=voice_router.db
LISTEN_ADDR=127.0.0.1:8080
# Optional bearer token for layer-1/user clients. Empty permits local unauthenticated use.
API_TOKEN=
# Required for review_mode=operator and the /v1/operator/* handoff console. Must differ from API_TOKEN.
OPERATOR_API_TOKEN=
# Optional. After each operator handoff commits, POST the ticket (phone/IIN masked,
# no API keys) here asynchronously with a 3 s timeout. Empty disables notification.
OPERATOR_WEBHOOK_URL=
